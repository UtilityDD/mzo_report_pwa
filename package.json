{
  "name": "mzo-reports",
  "version": "1.0.0",
  "private": true,
  "description": "MZO Reports: login-gated reporting PWA for Malda Zone (WBSEDCL)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "test": "node scripts/tools/run_tests.js",
    "sync:disconnection": "node --env-file-if-exists=.env scripts/sync/sync_disconnection_to_supabase.js",
    "sync:osd:crm": "node --env-file-if-exists=.env scripts/sync/sync_revenue_osd_from_crm.js",
    "sync:defective": "node --env-file-if-exists=.env scripts/sync/sync_defective_to_supabase.js",
    "sync:defective:crm": "node --env-file-if-exists=.env scripts/sync/sync_defective_from_crm.js",
    "sync:unbilled:crm": "node --env-file-if-exists=.env scripts/sync/sync_unbilled_from_crm.js",
    "sync:pending-mc": "node --env-file-if-exists=.env scripts/sync/sync_pending_mc_to_supabase.js",
    "sync:load-ext": "node --env-file-if-exists=.env scripts/sync/sync_load_ext_to_supabase.js",
    "tools:briefing-cccs": "node scripts/tools/compute_briefing_cccs.js",
    "tools:stock-categories": "node scripts/tools/generate_stock_material_category.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.22.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
