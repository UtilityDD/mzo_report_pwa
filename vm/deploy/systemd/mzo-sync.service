[Unit]
Description=MZO data mirror: copy due Sheets and Supabase datasets into PocketBase
After=network-online.target pocketbase.service
Wants=network-online.target pocketbase.service
# Skipped cleanly (not failed) until the sync code is deployed.
ConditionPathExists=/opt/mzo/app/vm/sync/run.js

[Service]
Type=oneshot
User=opc
WorkingDirectory=/opt/mzo/app/vm/sync
EnvironmentFile=/etc/mzo/pocketbase.env
# Supabase keys and the Insight switch, shared with the app (read-only GETs here; see vm/sync/sources/supabase.js).
EnvironmentFile=-/etc/mzo/app.env
Environment=NODE_ENV=production
Environment=MZO_SNAPSHOT_DIR=/opt/mzo/data/snapshots
# Shared with the app's refresh syncs, so the two never run at once.
Environment=SYNC_TMP_DIR=/opt/mzo/data/sync-tmp
# Data quality: previous headers and report dates, kept across releases.
Environment=MZO_QUALITY_STATE_DIR=/opt/mzo/data/quality
# The app's data folder (as in mzo-reports.service): Admin > Structure edits made on the VM live there.
Environment=MZO_FILES_DIR=/opt/mzo/data/files
CacheDirectory=mzo-sync
ExecStart=/usr/local/bin/node --max-old-space-size=160 --max-semi-space-size=4 /opt/mzo/app/vm/sync/run.js --due
SyslogIdentifier=mzo-sync
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
# The most expendable job on the VM: capped, and killed first if memory runs out.
# run.js syncs the sources in a child process (about 120 MB, the first full sync around 200 MB), then
# starts the derived steps one at a time from a parent of about 45 MB: uniform rows (up to ~200 MB),
# page views (~220 MB), data quality (~165 MB) and the performance rating (~270 MB).
MemoryMax=400M
OOMScoreAdjust=500
