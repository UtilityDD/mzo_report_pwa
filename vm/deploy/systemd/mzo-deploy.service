[Unit]
Description=MZO deploy: pull develop, restart the app, roll back on a failed health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root (restarts services, reloads Caddy); downloads and npm run as opc inside the script.
# The pinned copy in /opt/mzo/bin is refreshed only after a successful deploy.
ExecStart=/opt/mzo/bin/deploy.sh
EnvironmentFile=-/etc/mzo/deploy.env
SyslogIdentifier=mzo-deploy
TimeoutStartSec=15min
Nice=5
# npm ci fits in this; the app and sshd are protected ahead of it.
MemoryMax=350M
OOMScoreAdjust=200
