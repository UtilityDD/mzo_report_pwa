[Unit]
Description=MZO Reports app (node server.js on :3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/mzo/app
Environment=NODE_ENV=production
Environment=PORT=3000
# Mirror mode: serve report data from the local snapshots the sync writes (docs/architecture.md).
Environment=MZO_DATA_MODE=mirror
Environment=MZO_SNAPSHOT_DIR=/opt/mzo/data/snapshots
Environment=SYNC_TMP_DIR=/opt/mzo/data/sync-tmp
# Uploaded datasets (CRM extracts: disconnection, payments, unbilled) and the app's own runtime files.
# Outside the release folder, so a deploy never replaces them (opc only, mode 700).
Environment=MZO_FILES_DIR=/opt/mzo/data/files
# Users, sign-in and the activity log live in the VM's PocketBase (app_users, docs/users.md), not Supabase.
Environment=MZO_USER_STORE=pocketbase
# PocketBase credentials: the user store above, and a write can trigger a refresh sync of the datasets it changed.
EnvironmentFile=-/etc/mzo/pocketbase.env
# Optional extra env (JWT_SECRET and any keys); wins over the lines above, so MZO_DATA_MODE=off here turns mirror mode off.
EnvironmentFile=-/etc/mzo/app.env
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=3
# Keep the app alive when memory runs out (the sync goes first).
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
