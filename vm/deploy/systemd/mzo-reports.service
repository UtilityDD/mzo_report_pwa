[Unit]
Description=MZO Reports app (node server.js on :3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/mzo/app
Environment=NODE_ENV=production
Environment=PORT=3000
# Optional extra env (JWT_SECRET and any keys). Written by provision.sh, never in git.
EnvironmentFile=-/etc/mzo/app.env
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=3
# Keep the app alive when memory runs out (the sync goes first).
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
