[Unit]
Description=PocketBase (data mirror and admin portal backend) on 127.0.0.1:8090
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/mzo/pocketbase
# Keep the Go heap small on this 500 MB VM.
Environment=GOMEMLIMIT=150MiB
MemoryMax=200M
OOMScoreAdjust=100
# --automigrate=false: collection changes made through the dashboard or the API
# (the sync creates ds_* collections) must not write migration files into the
# release folder. Repo migrations in vm/pocketbase/pb_migrations still run at start.
ExecStart=/opt/mzo/pocketbase/pocketbase serve --http=127.0.0.1:8090 --dir=/opt/mzo/pocketbase/pb_data --migrationsDir=/opt/mzo/app/vm/pocketbase/pb_migrations --automigrate=false
Restart=on-failure
RestartSec=5
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mzo/pocketbase/pb_data

[Install]
WantedBy=multi-user.target
