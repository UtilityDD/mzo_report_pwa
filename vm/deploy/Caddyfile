# MZO VM web front. Installed to /etc/caddy/Caddyfile by vm/deploy/provision.sh and,
# after `caddy validate`, by deploy.sh whenever this file changes on develop.
# Certificates come from Let's Encrypt automatically (sslip.io names resolve to the VM).

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
		-X-Powered-By
	}
}

# The app (node server.js on :3000).
130.210.43.11.sslip.io {
	import security_headers
	# Compress what the app sends uncompressed (API JSON and CSV answers). The app already sends static
	# files, snapshots, rows and views as br/gzip, and encode leaves an encoded response alone.
	encode zstd gzip

	# Deploy record written by deploy.sh and polled by GitHub Actions (vm-deploy.yml).
	handle /deploy.json {
		root * /opt/mzo/state
		rewrite * /deployed.json
		header Cache-Control "no-store"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		# During a deploy restart node needs ~2 s to listen again: wait for it instead of a 502.
		reverse_proxy 127.0.0.1:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}

# Static admin portal files: strict CSP (the portal loads only its own scripts and styles).
(portal_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cache-Control "no-cache"
	}
}

# Data mirror: admin portal (static) and PocketBase (API and dashboard).
data.130.210.43.11.sslip.io {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# PocketBase keeps its own headers: the dashboard (/_/) sets what it needs.
	@pb path /api/* /_/*
	handle @pb {
		header /api/* {
			Cache-Control "no-store"
			defer
		}
		reverse_proxy 127.0.0.1:8090
	}

	# The app's UI kit, so the portal looks like the app. Only these three files.
	@kit path /kit/mzo_theme.css /kit/mzo_theme.js /kit/mzo_ui.js
	handle @kit {
		import portal_headers
		uri strip_prefix /kit
		root * /opt/mzo/app
		file_server
	}
	handle /kit/* {
		respond 404
	}

	# The Server page: the VM stats JSON from vm/stats/sampler.py and the page's script and styles.
	@vmdata path /vmstats/data/now.json /vmstats/data/hour.json /vmstats/data/day.json /vmstats/data/week.json
	handle @vmdata {
		uri strip_prefix /vmstats/data
		root * /run/mzo-stats
		header Cache-Control "no-store"
		file_server
	}
	@vmui path /vmstats/vmstats.js /vmstats/vmstats.css
	handle @vmui {
		import portal_headers
		uri strip_prefix /vmstats
		root * /opt/mzo/app/vm/stats/www
		file_server
	}
	handle /vmstats/* {
		respond 404
	}

	# vm/portal/dev/ (local test data) and the README sit inside the served folder.
	@hidden path /dev /dev/* *.md /.*
	handle @hidden {
		respond 404
	}

	handle {
		import portal_headers
		root * /opt/mzo/app/vm/portal
		file_server {
			hide .*
		}
	}
}

# VM stats (vm/stats): public, no sign-in. Read-only numbers (CPU, memory, disk, network, services),
# written every 5 s by mzo-stats.service into /run/mzo-stats. Only the listed files are served.
stats.130.210.43.11.sslip.io {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@data path /data/now.json /data/hour.json /data/day.json /data/week.json
	handle @data {
		uri strip_prefix /data
		root * /run/mzo-stats
		header Cache-Control "no-store"
		file_server
	}

	# The app's UI kit, so the page looks like the app. Only these three files.
	@kit path /kit/mzo_theme.css /kit/mzo_theme.js /kit/mzo_ui.js
	handle @kit {
		uri strip_prefix /kit
		root * /opt/mzo/app
		header Cache-Control "no-cache"
		file_server
	}

	@site path / /index.html /vmstats.js /vmstats.css /boot.js /main.js /favicon.svg /robots.txt
	handle @site {
		root * /opt/mzo/app/vm/stats/www
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		respond 404
	}
}

http://130.210.43.11 {
	redir https://130.210.43.11.sslip.io{uri}
}
