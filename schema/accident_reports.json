    "cause_of_accident": { "type": "text" },
    "addl_casue_of_accident": { "type": "text" },
    "inquiry_submitted_on": { "type": "date", "order": "dmy" },
    "inquiry_accepted_on": { "type": "date", "order": "dmy" },
    "incident_disposed_on": { "type": "date", "order": "dmy" },
    "payment_released_on": { "type": "date", "order": "dmy" },
    "age_of_victim": { "type": "number" },
    "date_of_accident": { "type": "date", "order": "dmy" },
    "pending_since_last_status_change_days": { "type": "number" }
