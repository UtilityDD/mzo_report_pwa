  "fields": {
    "victim_id": { "type": "text" },
    "victim_status": { "type": "text" },
    "accident_id": { "type": "text" },
    "status_description": { "type": "text" },
    "type_of_injury": { "type": "text" },
    "type_of_victim": { "type": "text" },
    "name_of_victim": { "type": "text" },
    "type_of_animal": { "type": "text" },
    "type_of_property": { "type": "text" },
    "name_of_owner_of_animal_property": { "type": "text" },
    "address_of_victim_owner_of_animal": { "type": "text" },
    "category_of_victim": { "type": "text" },
    "name_of_outsourced_agency": { "type": "text" },
    "type_of_job_performed": { "type": "text" },
    "skilled_or_not": { "type": "text" },
    "coverage_under_esi_or_not": { "type": "text" },
    "nature_of_injury": { "type": "text" },
    "fatality_on_enquery": { "type": "text" },
    "post_morten_attached": { "type": "text" },
    "incident_submitted_by_reporting_officer": { "type": "text" },
    "cug_no_of_reporting_officer": { "type": "text" },
    "authorised_or_not": { "type": "text" },
    "name_of_ccc_substation_re_project": { "type": "text" },
    "name_of_division_re_project": { "type": "text" },
    "name_of_the_region": { "type": "text" },
