{
  "key": "defective_details",
  "label": "Defective meter details",
  "source": { "hub": "CACHE_DEFECTIVE_DETAILS", "format": "csv" },
  "pages": ["consumer/defective_meter.html"],
  "keep": "pinned",
  "notes": "Consumer names of the priority metrics (loaded on demand). FIRST_REPORTED_DEF_DT and REPORT_AS_ON are yyyymmdd text. The tab can hold more than one report (REPORT_AS_ON per row); the page dedupes on CON_ID|METER_NO and says which reports its names come from. Flags are 0/1 counts.",
  "fields": {
    "con_id": { "type": "text", "aliases": ["CONS_ID", "CONSUMER_ID", "CONSUMER_NO", "CONSUMER_NUMBER", "CON_NO"] },
    "ccc_code": { "type": "text", "aliases": ["CCC", "CCC_CD", "CCCCODE", "CCC_NO", "CC_CODE", "SUPP_OFF", "OFFICE_CODE", "UNIT_CODE"] },
    "name": { "type": "text", "aliases": ["CON_NAME", "CONSUMER_NAME", "CUST_NAME", "NAME1"] },
    "address": { "type": "text", "aliases": ["ADDR", "ADDRESS1"] },
    "meter_no": { "type": "text", "aliases": ["MTR_NO", "METER", "METER_NUMBER", "METERNO"] },
    "first_reported_def_dt": { "type": "text", "aliases": ["FIRST_DEF_DT", "DEF_DT", "DEFECT_DT", "DEFECT_DATE"] },
    "phase": { "type": "text", "aliases": ["CONN_PHASE", "PH"] },
    "conn_load": { "type": "text", "aliases": ["CONNECTED_LOAD", "SANC_LOAD", "LOAD"] },
    "report_as_on": { "type": "text", "aliases": ["AS_ON", "REPORT_DATE", "RPT_DT", "TODAY"] },
    "base_class": { "type": "text", "aliases": ["BASECLASS"] },
    "conn_stat": { "type": "text", "aliases": ["STATUS", "CON_STAT", "CONN_STATUS"] },
    "mru": { "type": "text" },
    "mobile_no": { "type": "text", "aliases": ["MOBILE", "PHONE", "REG_MOB_NO", "MOBILENO"] },
    "over10": { "type": "number" },
    "ph3": { "type": "number" },
    "industrial": { "type": "number" },
    "smart": { "type": "number" },
    "load_gt6": { "type": "number" },
    "load_3_6": { "type": "number" },
    "load_1_3": { "type": "number" }
  }
}
