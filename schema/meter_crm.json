{
  "key": "meter_crm",
  "label": "Meter CRM data (meters used on CRM jobs)",
  "source": { "hub": "CACHE_METER_CRM", "format": "csv" },
  "pages": ["meter_utilization.html"],
  "keep": "pinned",
  "offices": false,
  "notes": "Dates are mostly yyyy-mm-dd hh:mm:ss, a few dd-mm-yyyy hh:mm.",
  "fields": {
    "meter_number": { "type": "text", "aliases": ["METER_NO"] },
    "con_id": { "type": "text", "aliases": ["CONS_ID"] },
    "prob_type": { "type": "text" },
    "meter_install_date": { "type": "date", "order": "dmy" },
    "serv_conn_date": { "type": "date", "order": "dmy" }
  }
}
