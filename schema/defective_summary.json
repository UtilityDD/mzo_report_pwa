{
  "key": "defective_summary",
  "label": "Defective meter summary",
  "source": { "hub": "CACHE_DEFECTIVE", "format": "csv" },
  "pages": ["consumer/defective_meter.html", "consumer/profile.html"],
  "keep": "pinned",
  "notes": "The published summary (counts per CCC x class x year x month). REPORT_AS_ON is yyyymmdd, kept as text (the page reads it). Offices come from CCC_CODE; REGION / DIVISION are the sheet's own labels. Aliases follow lib/defective_meter_pipeline.js FIELD_ALIASES.",
  "fields": {
    "report_as_on": { "type": "text", "aliases": ["AS_ON", "REPORT_DATE", "RPT_DT", "REPORTASON", "AS_ON_DATE", "TODAY"] },
    "ccc_code": { "type": "text", "aliases": ["CCC", "CCC_CD", "CCCCODE", "CCC_NO", "CC_CODE", "SUPP_OFF", "OFFICE_CODE", "UNIT_CODE"] },
    "base_class": { "type": "text", "aliases": ["BASECLASS"] },
    "defect_year": { "type": "number" },
    "total": { "type": "number" },
    "agri": { "type": "number" },
    "over10": { "type": "number" },
    "over5": { "type": "number" },
    "ph3": { "type": "number" },
    "industrial": { "type": "number" },
    "smart": { "type": "number" },
    "load_gt6": { "type": "number" },
    "load_3_6": { "type": "number" },
    "load_1_3": { "type": "number" },
    "load_05_1": { "type": "number" },
    "load_lt_05": { "type": "number" },
    "phase_1": { "type": "number" },
    "phase_3": { "type": "number" },
    "phase_other": { "type": "number" }
  }
}
