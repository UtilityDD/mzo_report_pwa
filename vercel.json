{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "data/costcenter.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    },
    {
      "src": "lib/assistant_catalog.js",
      "use": "@vercel/static"
    },
    {
      "src": "lib/defective_meter_pipeline.js",
      "use": "@vercel/static"
    },
    {
      "src": "lib/sheet_mirror_client.js",
      "use": "@vercel/static"
    },
    {
      "src": "lib/offices.js",
      "use": "@vercel/static"
    },
    {
      "src": "lib/uniform.js",
      "use": "@vercel/static"
    },
    {
      "src": "schema/*.json",
      "use": "@vercel/static"
    },
    {
      "src": "icons/*",
      "use": "@vercel/static"
    },
    {
      "src": "consumer/**",
      "use": "@vercel/static"
    },
    {
      "src": "rem/**",
      "use": "@vercel/static"
    },
    {
      "src": "dd/**",
      "use": "@vercel/static"
    },
    {
      "src": "docket/**",
      "use": "@vercel/static"
    },
    {
      "src": "power_map/**",
      "use": "@vercel/static"
    },
    {
      "src": "prt-oil/**",
      "use": "@vercel/static"
    },
    {
      "src": "si-works/**",
      "use": "@vercel/static"
    },
    {
      "src": "stock/**",
      "use": "@vercel/static"
    },
    {
      "src": "Upkeeping/**",
      "use": "@vercel/static"
    },
    {
      "src": "dtr/**",
      "use": "@vercel/static"
    },
    {
      "src": "nsc/**",
      "use": "@vercel/static"
    },
    {
      "src": "accident/**",
      "use": "@vercel/static"
    },
    {
      "src": "smart_meter/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(server\\.js|package(-lock)?\\.json|vercel\\.json)",
      "status": 404
    },
    {
      "src": "/(scripts|apps-script|node_modules|vm|\\.github)/.*",
      "status": 404
    },
    {
      "src": "/.*\\.(md|mdc|gs|sql|py)",
      "status": 404
    },
    {
      "src": "^/nsc_(simple|pipeline|classic)\\.html$",
      "status": 302,
      "headers": {
        "Location": "/nsc.html"
      }
    },
    {
      "src": "^/(index\\.html)?$",
      "status": 302,
      "headers": {
        "Location": "/app.html"
      }
    },
    {
      "src": "/performance_index/?",
      "status": 308,
      "headers": {
        "Location": "/performance_index.html"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
