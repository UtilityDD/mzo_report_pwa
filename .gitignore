# Secrets and local environment
.env
.env*
.vercel
.idea
.vscode
.DS_Store

/node_modules

# Datasets never go into git: uploads and CRM extracts live in the server's data folder
# (MZO_FILES_DIR on the VM, this git-ignored data/ locally). scripts/tools/check_data_files.js
# fails CI on a tracked one. The only exceptions are the two small lookups that ship with the
# code (re-included at the end of this file): data/costcenter.json, data/structure.csv and
# data/org/wbsedcl_hierarchy.json (WBSEDCL office names and codes, Admin → Organisation).
/data/*
data/*.csv
data/*.json
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.ods
*.parquet
*.sqlite
*.sqlite3
*.db
*.ndjson
*.jsonl

# Local PocketBase binary and data, and the sync dependencies (vm/)
/vm/pocketbase/local/
/vm/sync/node_modules/
/vm/sync/.tmp/

# Data quality: header-drift state and the local test PocketBase (vm/quality)
/vm/quality/.state/
/vm/quality/.pb/

# Local data downloads for analysis scripts (never committed)
/.scratch/
__pycache__/
*.class

# Re-included lookups (see the data section above); keep these lines last.
!/data/costcenter.json
!/data/structure.csv
!/data/org/
/data/org/*
!/data/org/wbsedcl_hierarchy.json
