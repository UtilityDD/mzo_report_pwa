# Secrets and local environment
.env
.env*
.vercel
.idea
.vscode
.DS_Store

/node_modules

# Datasets never go into git: uploads and CRM extracts live in the server's data folder
# (MZO_FILES_DIR on the VM, this git-ignored data/ locally). scripts/tools/check_data_files.js
# fails CI on a tracked one. The only exceptions are the two small lookups that ship with the
# code (re-included at the end of this file): data/costcenter.json, data/structure.csv and
# data/org/wbsedcl_hierarchy.json (WBSEDCL office names and codes, Admin → Organisation).
/data/*
data/*.csv
data/*.json
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.ods
*.parquet
*.sqlite
*.sqlite3
*.db
*.ndjson
*.jsonl

# Local PocketBase binary and data, and the sync dependencies (vm/)
/vm/pocketbase/local/
/vm/sync/node_modules/
/vm/sync/.tmp/

# Power Map V2 source deps (built assets under power_map/v2/ are committed)
/power_map/powermap-v2/node_modules/
/power_map/powermap-v2/dist/

# Migrations PocketBase writes by itself when it runs with --automigrate=true (its default) against
# this folder: one per collection created, updated or deleted through its API, e.g. by the sync or a
# test. They must never be committed; hand-written ones are named <timestamp>_<what>.js without these
# words (scripts/tools/check_migrations.js fails CI on them).
/vm/pocketbase/pb_migrations/*_created_*.js
/vm/pocketbase/pb_migrations/*_updated_*.js
/vm/pocketbase/pb_migrations/*_deleted_*.js
/vm/pocketbase/pb_migrations/*_ds_zz*.js

# Data quality: header-drift state and the local test PocketBase (vm/quality)
/vm/quality/.state/
/vm/quality/.pb/

# Local data downloads for analysis scripts (never committed)
/.scratch/
__pycache__/
*.class

# Re-included lookups (see the data section above); keep these lines last.
!/data/costcenter.json
!/data/structure.csv
!/data/org/
/data/org/*
!/data/org/wbsedcl_hierarchy.json
# Tiny offline OSD smoke CSV for sync_revenue_osd_from_crm.js --fixture
!/scripts/fixtures/
!/scripts/fixtures/*.csv
